[Unit]
Description=API Beneficiarios (LAB vulnerable - articulo Wazuh)
After=network.target

[Service]
Type=simple
User=labapi
WorkingDirectory=/opt/vulnerable-api
ExecStart=/opt/vulnerable-api/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
